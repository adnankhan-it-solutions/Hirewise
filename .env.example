# Reference only: export these via your deployment environment/secret manager.
ENVIRONMENT=development
PLATFORM_NAME=Hirewise
SUPPORT_EMAIL=
PUBLIC_ORIGIN=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DEFAULT_TIMEZONE=Asia/Qatar
# Production: random >=50 characters, stored only in secrets manager.
SECRET_KEY=
# Production requires PostgreSQL and TLS; use a dedicated runtime DB role.
DATABASE_URL=
# Fernet.generate_key(), stored in secrets manager; required in production.
MFA_ENCRYPTION_KEY=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
PRIVATE_BUCKET=
S3_ENDPOINT_URL=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLAMDSCAN_PATH=clamdscan
# Optional internal sandbox only; does not enable real payments.
SANDBOX_WEBHOOK_SECRET=
# Enable only behind a proxy that strips incoming forwarding headers.
TRUST_PROXY=0
